<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>SocialCashFlow - Add New Transaction</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 font-sans">
  <header class="flex justify-between items-center p-6 bg-white shadow">
    <h1 class="text-xl font-bold text-blue-600">SocialCashFlow</h1>
    <nav>
      <ul class="flex space-x-6 text-sm font-medium">
        <li><a href="#" class="text-black">Dashboard</a></li>
        <li><a href="/transactions/add" class="text-black">Add Transactions</a></li>
      </ul>
    </nav>
  </header>

  <main class="max-w-4xl mx-auto my-10 bg-white p-8 rounded shadow">
    <h2 class="text-2xl font-bold mb-6">Add New Transaction</h2>
    <p class="text-gray-600 mb-6">Record money paid or received from your friends.</p>

    <!-- Toggle Buttons -->
    <div class="mb-6">
      <div class="inline-flex rounded overflow-hidden border border-gray-200" id="toggleWrapper">
        <button type="button" id="youPaidBtn" class="bg-blue-600 text-white px-4 py-2">You Paid</button>
        <button type="button" id="youReceivedBtn" class="bg-gray-100 text-gray-700 px-4 py-2">You Received</button>
      </div>
    </div>

    <form class="space-y-6" method="POST" action="/addtransaction" onsubmit="handleDynamicFields(event)">
      <fieldset class="border rounded p-6">
        <legend class="text-lg font-semibold mb-4" id="formTitle">Money You Paid to a Friend</legend>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium mb-1" for="friendName">Friend's Name</label>
            <select name="friendName" id="friendName" class="w-full border rounded px-3 py-2" required>
              <option value="" disabled selected>Select a friend</option>
              <option value="Ayush">Ayush</option>
              <option value="Viraj">Viraj</option>
              <option value="Abhinav">Abhinav</option>
              <option value="Rakesh">Rakesh</option>
            </select>
            <p class="text-gray-500 text-sm mt-1">Select the name of your friend involved in this transaction.</p>
          </div>

          <div>
            <label class="block text-sm font-medium mb-1" for="amount">Amount</label>
            <input type="number" name="amount" step="0.01" class="w-full border rounded px-3 py-2" value="0.00" required>
            <p class="text-gray-500 text-sm mt-1">Enter the amount in your preferred currency.</p>
          </div>

          <div>
            <label class="block text-sm font-medium mb-1" for="transactionDate">Transaction Date</label>
            <input type="date" name="transactionDate" class="w-full border rounded px-3 py-2" value="<%= new Date().toISOString().split('T')[0] %>" required>
            <p class="text-gray-500 text-sm mt-1">When did this transaction occur?</p>
          </div>

          <div>
            <label class="block text-sm font-medium mb-1" for="repaymentDays">Repayment Days</label>
            <input type="number" name="repaymentDays" class="w-full border rounded px-3 py-2" value="7" required>
            <p class="text-gray-500 text-sm mt-1">After how many days should this be repaid?</p>
          </div>

          <div class="md:col-span-2">
            <label class="block text-sm font-medium mb-1" for="description">Description</label>
            <textarea name="description" class="w-full border rounded px-3 py-2" rows="3" placeholder="E.g., Dinner at restaurant, movie tickets, etc."></textarea>
            <p class="text-gray-500 text-sm mt-1">Brief description of what this payment was for.</p>
          </div>
        </div>
      </fieldset>

      <!-- Hidden dynamic fields -->
      <input type="hidden" name="paidBy" id="paidBy" value="John Doe">
      <input type="hidden" name="receivedBy" id="receivedBy" value="">

      <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded w-full">
        Add Transaction
      </button>
    </form>
  </main>

  <script>
    let transactionType = "youPaid"; // Default selection
    const paidByInput = document.getElementById("paidBy");
    const receivedByInput = document.getElementById("receivedBy");
    const friendInput = document.getElementById("friendName");
    const formTitle = document.getElementById("formTitle");

    document.getElementById("youPaidBtn").addEventListener("click", () => {
      transactionType = "youPaid";
      updateToggleStyle();
      formTitle.innerText = "Money You Paid to a Friend";
    });

    document.getElementById("youReceivedBtn").addEventListener("click", () => {
      transactionType = "youReceived";
      updateToggleStyle();
      formTitle.innerText = "Money You Received from a Friend";
    });

    function updateToggleStyle() {
      const youPaidBtn = document.getElementById("youPaidBtn");
      const youReceivedBtn = document.getElementById("youReceivedBtn");
      if (transactionType === "youPaid") {
        youPaidBtn.classList.add("bg-blue-600", "text-white");
        youReceivedBtn.classList.remove("bg-blue-600", "text-white");
        youReceivedBtn.classList.add("bg-gray-100", "text-gray-700");
      } else {
        youReceivedBtn.classList.add("bg-blue-600", "text-white");
        youPaidBtn.classList.remove("bg-blue-600", "text-white");
        youPaidBtn.classList.add("bg-gray-100", "text-gray-700");
      }
    }

    function handleDynamicFields(event) {
      const friendName = friendInput.value;
      if (!friendName) {
        alert("Please select your friend's name.");
        event.preventDefault();
        return;
      }

      if (transactionType === "youPaid") {
        paidByInput.value = "Dakshit Singh";
        receivedByInput.value = friendName;
      } else {
        paidByInput.value = friendName;
        receivedByInput.value = "Dakshit Singh";
      }
    }
  </script>
</body>
</html>
